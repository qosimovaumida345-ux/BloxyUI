# ==========================================
# BloxyUI Environment Variables (.env)
# ==========================================

# Server Port (Default: 3001)
PORT=3001

# Environment Mode: 'development' yoki 'production'
NODE_ENV=development

# ==========================================
# PostgreSQL Database Connection
# ==========================================
# 1. LOCAL kompyuterda (PostgreSQL o'rnatilgan bo'lsa):
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/bloxyui?schema=public"

# 2. RENDER.COM yoki NEON / SUPABASE (Production uchun):
# Render.com da bepul PostgreSQL database yaratilganda beriladigan URL:
# DATABASE_URL="postgres://bloxyui_user:password@dpg-xxxxxx.oregon-postgres.render.com/bloxyui"

# ESLATMA: Agar hozircha PostgreSQL ulamasangiz ham, server avtomatik ravishda
# server/data/catalog.js va bloxfxCatalog.js ichidagi 520+ icon va 200 ta effectlar
# bilan 100% to'liq ishlayveradi (fallback rejimida hech qanday xatolik bermaydi).
