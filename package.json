{
  "name": "bloxyui-backend",
  "version": "1.0.0",
  "description": "BloxyUI Backend",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm install --include=dev && npm run build",
    "start": "node scripts/start-production.js",
    "db:migrate": "npx prisma db push --skip-generate",
    "db:seed": "node prisma/seed.js",
    "postinstall": "npx prisma generate && cd client && npm install --include=dev && npm run build",
    "mcp": "node server/mcp/server.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.4.0",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "nodemon": "^3.1.0",
    "concurrently": "^9.0.0"
  }
}
